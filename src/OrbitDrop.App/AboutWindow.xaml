<Window x:Class="OrbitDrop.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About OrbitDrop" Height="420" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="OrbitDrop" FontSize="24" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}" />
        <TextBlock x:Name="VersionText" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
        <TextBlock Text="A radial-menu file utility for Windows." Margin="0,8,0,0"
                   Foreground="{StaticResource TextPrimary}" />

        <TextBlock Margin="0,18,0,0" Foreground="{StaticResource TextMuted}">
            <Run Text="Author: " /><Run Text="b3n3d1ck" Foreground="{StaticResource TextPrimary}" />
        </TextBlock>
        <TextBlock Foreground="{StaticResource TextMuted}">
            <Run Text="Repository: " />
            <Hyperlink NavigateUri="https://github.com/b3n3d1ck" RequestNavigate="OnNavigate">
                github.com/b3n3d1ck
            </Hyperlink>
        </TextBlock>
        <TextBlock Foreground="{StaticResource TextMuted}">
            <Run Text="License: MIT (application). See third-party notices." />
        </TextBlock>

        <TextBlock Text="Dependencies" FontWeight="SemiBold" Margin="0,18,0,6"
                   Foreground="{StaticResource TextPrimary}" />
        <TextBlock Foreground="{StaticResource TextMuted}" TextWrapping="Wrap">
            SixLabors.ImageSharp (Six Labors Split License / commercial),
            CommunityToolkit.Mvvm (MIT). Full inventory in docs/DEPENDENCIES.md.
        </TextBlock>

        <TextBlock x:Name="BuildText" Foreground="{StaticResource TextMuted}" Margin="0,18,0,0" />

        <Button Content="Close" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                Margin="0,22,0,0" Click="OnClose" />
    </StackPanel>
</Window>
