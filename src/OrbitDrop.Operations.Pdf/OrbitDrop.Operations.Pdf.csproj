<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OrbitDrop.Operations.Pdf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ImageSharp is used only to produce the embedded JPEG. The PDF itself is written by
         our own code (MinimalPdf), so there is no PDF-library dependency and no new license. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrbitDrop.Core\OrbitDrop.Core.csproj" />
  </ItemGroup>
</Project>
